{
  "name": "el-andino",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@el-andino/web",
    "build": "npm run build --workspace=@el-andino/web",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:watch": "npm run test:watch --workspace=@el-andino/web"
  },
  "devDependencies": {
    "jimp": "^0.16.13",
    "vitest": "^3.0.0"
  }
}
